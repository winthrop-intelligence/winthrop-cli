{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "UTC",
  "schedule": [
    "before 6am on monday"
  ],
  "semanticCommits": "disabled",
  "prConcurrentLimit": 10,
  "enabledManagers": [
    "gomod",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "schedule": [
        "before 6am on monday"
      ]
    }
  ]
}
